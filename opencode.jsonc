{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "faktory": {
      "type": "remote",
      "url": "https://faktory.holdenitdown.net/mcp",
      "enabled": true
    },
    "faktory-local": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "oauth": false,
      "enabled": false,
      "timeout": 30000
    },
    "faktory-preview": {
      "type": "remote",
      "url": "https://preview-faktory.holdenitdown.net/mcp",
      "enabled": false
    }
  }
}
